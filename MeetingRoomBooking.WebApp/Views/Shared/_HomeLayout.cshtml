@using System.Security.Claims
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.ActivePage</title>

    <!-- FullCalendar CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/main.min.css">

    <!-- FullCalendar JS -->
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/main.min.js"></script>

    <link rel="stylesheet" href="~/css/components.css" />
    <link href="~/css/header.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/HomeStyles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
    @RenderSection("style", required: false)
</head>
<body>
    <div class="screen">
        <aside class="aside column" id="navbar">
            <div class="group">
                <div class="logo-container" id="navbar-toggle">
                    <img src="~/assets/meetingRoomLogo.png" class="logo"  />
                    <div class="column navbar-item-text">
                        <span class="name company">
                            BANKY SOLUTIONS
                        </span>
                        <span class="name meet">
                            Meeting Room Booking
                        </span>
                    </div>
                </div>

                <ul class="navbar-list">
                    <li class="sidebar-item @(ViewBag.ActivePage == "Dashboard" ? "active" : "")">
                        <a class="no-underline" href="@Url.Action("Index", "Home")">
                            <i class="bi bi-grid-1x2"></i>
                            <span class="navbar-item-text">Dashboard</span>
                        </a>
                    </li>
                    <li class="sidebar-item @(ViewBag.ActivePage == "BookingManagement" ? "active" : "")">
                        <a class="no-underline" href="@Url.Action("Index", "BookingManagement")">
                            <i class="bi bi-journal-bookmark-fill"></i>
                            <span class="navbar-item-text">Booking</span>
                        </a>
                    </li>
                    @if (int.TryParse(User.FindFirstValue("Role"), out int role) && role == 2 || role == 1) {
                        <li class="sidebar-item @(ViewBag.ActivePage == "UserManagement" ? "active" : "")">
                            <a class="no-underline" href="@Url.Action("Index", "UserManagement")">
                                <i class="bi bi-people"></i>
                                <span class="navbar-item-text">User Management</span>
                            </a>
                        </li>
                        <li class="sidebar-item @(ViewBag.ActivePage == "RoomManagement" ? "active" : "")">
                            <a class="no-underline" href="@Url.Action("Index", "RoomManagement")">
                                <i class="bi bi-door-open"></i>
                                <span class="navbar-item-text">Room Management</span>
                            </a>
                        </li>
                    }
                    <li class="sidebar-item @(ViewBag.ActivePage == "Report & Analytics" ? "active" : "")">
                        <a class="no-underline" href="@Url.Action("ReportAnalytics", "Home")">
                            <i class="bi bi-clipboard-data"></i>
                            <span class="navbar-item-text">Report Analytics</span>
                        </a>
                    </li>
                    <li class="sidebar-item @(ViewBag.ActivePage == "Setting" ? "active" : "")">
                        <a class="no-underline" href="@Url.Action("Setting", "Home")">
                            <i class="bi bi-gear"></i>
                            <span class="navbar-item-text">Settings</span>
                        </a>
                    </li>

                </ul>
            </div>
            

            <div class="logout-section">
                <div class="horizontal-line"></div>
                <a class="logout" asp-controller="Account" asp-action="Logout">
                    <i class="bi bi-box-arrow-right"></i>
                    <span class="navbar-item-text">Logout</span>
                </a>
            </div>
            

        </aside>


        <div class="main">
            @Html.Partial("Components/_Header")
            <div class="content">
                @RenderBody()
            </div>
        </div>
    </div>
    

    
    @Html.Partial("Components/_FilterModal")

    @section Scripts {
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    }
    
    <script src="~/js/navbar.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    @await RenderSectionAsync("script", required: false)
</body>
</html>