@using System.Security.Claims
<header>
    <div class="flex-center left-header">
        <span class="page">
            @ViewBag.ActivePage
        </span> 
    </div>
    <div class="middle-header"></div>
    <div class="right-header">
            <div class="profile-area" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <div class="profile-name">@User.FindFirstValue(ClaimTypes.Name)</div>
            </div>
    </div>
</header>