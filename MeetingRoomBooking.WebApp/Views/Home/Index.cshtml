@using System.Security.Claims
@section style {
    <link rel="stylesheet" href="~/css/dashboard.css" />

}

@{
    Layout = "_HomeLayout";
    ViewData["Title"] = "Dashboard";
}

@if (int.TryParse(User.FindFirstValue("Role"), out int role) && role == 2 || role == 1) {
    <partial name="AdminDashboard" />
}else {
    <partial name="UserDashboard" />
}

    