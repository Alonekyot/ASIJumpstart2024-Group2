@model MeetingRoomBooking.Services.ServiceModels.LeaderBoardLists
@{
    Layout = "_HomeLayout";
}
@section style {
    <link rel="stylesheet" href="~/css/ReportAnalytics.css" />
}
@section script {
    <script src="~/js/chart.js"></script>
}

<div class="grid">
    <div class="data-grid">
        <div class="data-card">
            <span class="data-title">Today's Bookings'</span>
            <span class="data">@ViewBag.TodaysBooking</span>
        </div>
        <div class="data-card">
            <span class="data-title">Recurring Bookings</span>
            <span class="data">@ViewBag.Recurrings</span>
        </div>
        <div class="data-card">
            <span class="data-title">Total Users</span>
            <span class="data">@ViewBag.UserCount</span>
        </div>
        <div class="data-card">
            <span class="data-title">Total Meeting Rooms</span>
            <span class="data">@ViewBag.RoomCount</span>
        </div>
    </div>
    <div class="shadow-sm report-card">
        <canvas id="myChart"></canvas>
    </div>
    <div class="shadow-sm report-card leaderboard">
        <div class="leaderboard-header">
            <h6>Top Rooms</h6>
        </div>
        <div class="leaderboard-data-list">
            <hr style="margin: 0.25rem 0;" />
            @foreach(var room in Model.RoomLeaders) {
                
                <div class="leaderboard-data">
                    <h6>@room.RoomName</h6>
                    <span>@room.BookedTimes Booked</span>
                </div>
                <hr style="margin: 0.25rem 0;" />
            }
            
        </div>
    </div>
    <div class="shadow-sm report-card leaderboard">
        <div class="leaderboard-header">
            <h6>Top Users</h6>
        </div>
        <div class="leaderboard-data-list">
            <hr style="margin: 0.25rem 0;" />
            @foreach (var user in Model.UserLeaders) {

                <div class="leaderboard-data">
                    <h6>@user.Username</h6>
                    <span>@user.BookedTimes Booked</span>
                </div>
                <hr style="margin: 0.25rem 0;" />
            }

        </div>
    </div>
</div>