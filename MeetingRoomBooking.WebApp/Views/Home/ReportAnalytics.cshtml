@{
    Layout = "_HomeLayout";
}
@section style {
    <link rel="stylesheet" href="~/css/ReportAnalytics.css" />
}

<div class="grid">
    <div class="data-grid">
        <div class="data-card">
            <span class="data-title">Today's Bookings'</span>
            <span class="data">3</span>
        </div>
        <div class="data-card">
            <span class="data-title">Recurring Bookings</span>
            <span class="data">3</span>
        </div>
        <div class="data-card">
            <span class="data-title">Reschedule Bookings</span>
            <span class="data">3</span>
        </div>
        <div class="data-card">
            <span class="data-title">Total Meeting Rooms</span>
            <span class="data">@ViewBag.RoomCount</span>
        </div>
    </div>
    <div></div>
    <div></div>
    <div></div>
</div>