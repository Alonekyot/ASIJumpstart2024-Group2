@model IEnumerable<MeetingRoomBooking.Services.ServiceModels.BookingModel>

@section style {
    <link rel="stylesheet" href="~/css/dashboard.css" />
    <link rel="stylesheet" href="~/css/SearchBars.css" />
    <link rel="stylesheet" href="~/css/notificationBox.css" />
}

@{
    Layout = "_HomeLayout";
    ViewData["Title"] = "Dashboard";
}

<div class="use-font">
    <h5>Dashboard</h5>
    <div class="center-flex card-grp">
        <div class="custom-card center-flex total-meeting">
            <div class="left-color">
            </div>
            <div class="card-text">
                <h4>@ViewBag.RoomCount</h4>
                <p>Total Meeting Rooms</p>
            </div>
            <div class="card-icon">
                <div class="card-circle center-flex">
                    <i class="bi bi-calendar2-week"></i>
                </div>
            </div>
        </div>
        <div class="custom-card center-flex recurring-booking">
            <div class="left-color">
            </div>
            <div class="card-text">
                <h4>@ViewBag.Recurrings</h4>
                <p>Recurring Bookings</p>
            </div>
            <div class="card-icon">
                <div class="card-circle center-flex">
                    <i class="bi bi-repeat"></i>
                </div>
            </div>
        </div>
        <div class="custom-card center-flex reschedule-booking">
            <div class="left-color">
            </div>
            <div class="card-text">
                <h4>@ViewBag.UserCount</h4>
                <p>Total Users</p>
            </div>
            <div class="card-icon">
                <div class="card-circle center-flex">
                    <i class="bi bi-people"></i>
                </div>
            </div>
        </div>
        <div class="custom-card center-flex todays-booking">
            <div class="left-color">
            </div>
            <div class="card-text">
                <h4>@ViewBag.TodaysBooking</h4>
                <p>Today's Meetings</p>
            </div>
            <div class="card-icon">
                <div class="card-circle todays-booking-icon center-flex">
                    <i class="bi bi-calendar2-week"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="top-of-table">
        <h4>
            List of bookings
        </h4>
        <div class="search-group">
            <form class="dashboard-search-group" asp-action="SearchBooking" method="post">
                <input type="text" placeholder="Search" class="dashboard-search" name="filter" />
                <button class="dashboard-search-btn" type="submit"><i class="bi bi-search"></i></button>
            </form>
        </div>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Meeting Title</th>
                <th>User</th>
                <th>Room Name</th>
                <th>Meeting Date</th>
                <th>Start Time</th>
                <th>End Time</th>
                <th>Booking Status</th>
                <th>Location</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody class="table-group-divider">
            @foreach (var booking in Model)
            {
                <tr>
                    <td>@booking.MeetingTitle</td>
                    <td>@booking.UserName</td>
                    <td>@booking.RoomName</td>
                    <td>@booking.MeetingDate</td>
                    <td>@booking.StartTime</td>
                    <td>@booking.EndTime</td>                 
                    <td>@booking.BookingStatus</td>
                    <td>@booking.RoomLocation</td>  
                    <td class="icons-area">
                        <a class="table-icon" asp-route-id="@booking.BookingID", asp-controller="BookingManagement" asp-action="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                        <a href="#" class="table-icon" data-id="@booking.BookingID" data-bs-toggle="modal" data-bs-target="#exampleModal" data-status="@booking.BookingStatus">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div>
    <ul class="pagination">
        <li class="page-item"><a class="page-link" href="#">Prev</a></li>
        <li class="page-item"><a class="page-link" href="#">1</a></li>
        <li class="page-item"><a class="page-link" href="#">2</a></li>
        <li class="page-item"><a class="page-link" href="#">3</a></li>
        <li class="page-item"><a class="page-link" href="#">Next</a></li>
    </ul>
</div>

<!--MODAL CLASS-->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Cancel Booking</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="modal-body-text">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <form asp-action="CancelBooking" method="post">
                    @Html.AntiForgeryToken()
                    @Html.Hidden("BookingID")
                    <input type="hidden" name="BookingID" id="BookingID" />
                    <button type="submit" class="btn btn-danger" id="modal-confirm-btn"></button>
                </form>
            </div>
        </div>
    </div>
</div>
<style>
#exampleModal .modal-dialog {
    opacity: 0;
    transform: translateY(-10px);
    transition: opacity 0.5s ease, transform 0.5s ease;
}

#exampleModal.show .modal-dialog {
    opacity: 1;
    transform: translateY(0);
}
</style>
@if (TempData["CanceledSucess"] != null)
{
    <div id="notification" class="alert alert-success notification" style="background-color: #f5f093; color: #757015">
        @TempData["CanceledSucess"]
    </div>
    <audio id="notificationSound" src="/sound/notificationSound.mp3" preload="auto"></audio>
}

<script>
    let notificationPlayed = false; // Ensure the sound is played only once

    window.onload = function () {
        const notification = document.getElementById('notification');
        const sound = document.getElementById('notificationSound');

        if (notification && sound && !notificationPlayed) {
            sound.play().catch(error => {
                console.error("Notification sound failed to play:", error);
            });
            
            notificationPlayed = true; // Mark as played

            // Optionally fade out the notification after a delay
            setTimeout(() => {
                notification.style.opacity = '0';
                setTimeout(() => notification.remove(), 500); // Remove from DOM after fade-out
            }, 2000);
        }
    };
</script>

<script>
    var exampleModal = document.getElementById('exampleModal');
    exampleModal.addEventListener('show.bs.modal', function (event) {
        var button = event.relatedTarget; // Button that triggered the modal
        var bookingId = button.getAttribute('data-id'); // Extract RoomId from data-* attribute
        var bookingStatus = button.getAttribute('data-status'); // Extract status from data-* attribute
        var modalBody = exampleModal.querySelector('#modal-body-text');
        var confirmButton = exampleModal.querySelector('#modal-confirm-btn');
        var modalForm = exampleModal.querySelector('form');

        // Set the hidden RoomId input field with the roomId
        modalForm.querySelector('input[name="BookingID"]').value = bookingId;

        if (bookingStatus === 'Scheduled') {
            modalBody.textContent = 'Are you sure you want to cancel this booking?';
            confirmButton.textContent = 'Cancel';
        } else if (bookingStatus === 'Canceled') {
            modalBody.textContent = 'Are you sure you want to delete this canceled booking?';
            confirmButton.textContent = 'Delete';
        }
    });
</script>
<style>
    .table-icon i {
        color: black;
    }

    .icons-area {
        display: flex;
        justify-content: space-evenly;
    }
</style>