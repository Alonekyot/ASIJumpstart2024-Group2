@model MeetingRoomBooking.Services.ServiceModels.ForgotPasswordViewModel

@section style {
    <link rel="stylesheet" href="/css/Setting.css" />
}

@{
    Layout = "_HomeLayout";
}

<div class="form-container">
    <form method="post" asp-controller="Account" asp-action="SubmitPassword">
        <div class="form-group">
            <label for="about">About yourself</label>
            <textarea id="about" name="about" placeholder="Add bio..."></textarea>
        </div>
        <div class="form-group">
            <div class="itemRow">
                <div>
                    <span class="notif">Notification Sound </span>
                    <h6 class="uno">Use sounds to notify you about incoming notifications</h6>
                </div>
                <div>
                    <label class="switch">
                        <input type="checkbox" checked>
                        <span class="slider round"></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="itemRow">
                <div>
                    <span class="notif">Do not disturb</span>
                    <h6 class="uno">Mute Notifications</h6>
                </div>
                <div>
                    <label class="switch">
                        <input type="checkbox" checked>
                        <span class="slider round"></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group password-section">
            <span class="pass">Change Password</span>
            <p>Your password must be at least 6 characters and should include a combination of numbers, letters, and special characters. (<span>&#33;&#36;&#64;&#37;</span>)</p>
            <label for="new-password">Email</label>
            <input asp-for="Email" type="text" class="input-text">
            <label for="new-password">New Password</label>
            <input asp-for="NewPassword" type="password" id="password">
            <label for="retype-password">Re-type New Password</label>
            <input input asp-for="ConfirmNewPassword" type="password" id="confirm-password">
            <span asp-validation-for="ConfirmNewPassword" class="error-message"></span>
        </div>
        <div class="button-group">
            <button type="button" class="cancel-btn">Cancel</button>
            <button type="submit" class="save-btn">Save Changes</button>          

        </div>
    </form>
</div>