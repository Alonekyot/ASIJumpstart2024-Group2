@model MeetingRoomBooking.Services.ServiceModels.ChangePasswordModel

@section style {
    <link rel="stylesheet" href="/css/Setting.css" />
}

@section script {
    <script src="~/js/notification.js"></script>
}

@{
    Layout = "_HomeLayout";
}

<div class="form-container">
    <form method="post" asp-controller="Home" asp-action="ChangePassword">
        <div class="form-group">
            <label for="about">About yourself</label>
            <textarea id="about" name="about" placeholder="Add bio..."></textarea>
        </div>
        <div class="form-group">
            <div class="itemRow">
                <div>
                    <span class="notif">Notification Sound </span>
                    <h6 class="uno">Use sounds to notify you about incoming notifications</h6>
                </div>
                <div>
                    <!-- Rounded switch -->
                    <label class="switch">
                        <input type="checkbox" id="notiSwitch" asp-for="Notif" checked="@ViewBag.Notif">
                        <span class="slider round"></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="itemRow">
                <div>
                    <span class="notif">Do not disturb</span>
                    <h6 class="uno">Mute Notifications</h6>
                </div>
                <div>
                    <!-- Rounded switch -->
                    <label class="switch">
                        <input type="checkbox">
                        <span class="slider round"></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group password-section">
            <span class="pass">Change Password</span>
            <p>Your password must be at least 6 characters and should include a combination of numbers, letters, and special characters. (<span>&#33;&#36;&#64;&#37;</span>)</p>

            <label for="current-password">Current Password</label>
            <input asp-for="CurrentPassword" type="password" class="input-text">
            <span asp-validation-for="CurrentPassword" class="error-message"></span>

            <label for="new-password">New Password</label>
            <input asp-for="NewPassword" type="password" id="password">
            <span asp-validation-for="NewPassword" class="error-message"></span>

            <label for="retype-password">Confirm Password</label>
            <input input asp-for="ConfirmPassword" type="password" id="confirm-password">
            <span asp-validation-for="ConfirmPassword" class="error-message"></span>

        </div>


        <div class="button-group">
            <button type="button" class="cancel-btn">Cancel</button>
            <button type="submit" class="save-btn">Save Changes</button>          

        </div>
    </form>
</div>

@if (TempData["SuccessMessage"] != null)
    {
        <div id="notification" class="alert alert-success notification">
        @TempData["SuccessMessage"]
        </div>
        <audio id="notificationSound" src="/sound/notificationSound.mp3" preload="auto"></audio>
    }