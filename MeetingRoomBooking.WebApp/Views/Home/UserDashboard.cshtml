@model IEnumerable<MeetingRoomBooking.Services.ServiceModels.BookingModel>

@{
    Layout = "_HomeLayout";
    ViewData["Title"] = "Dashboard";
}

<style>
    .fc-daygrid-day {
        max-width: 30px !important; /* Set desired width */
        max-height: 30px !important; /* Set desired height */
    }
</style>
@section style {
    <link rel="stylesheet" href="~/css/calendar.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" />

}
<link rel="stylesheet" href="~/css/calendar.css" />
<link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.0/main.min.css" rel="stylesheet" />

<div style="display: flex; flex: 1;">
    <div id="calendar"></div>
</div>


@* Reference the FullCalendar script *@
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.0/main.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var calendarEl = document.getElementById('calendar');

        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            events: '/Home/GetEvents', // Call the controller action
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,timeGridDay'
            },
        });

        calendar.render();
    });
</script>

<table class="table">
    <thead>
        <tr>
            <th>Meeting Title</th>
            <th>Booking Status</th>
            <th>...</th>
        </tr>
    </thead>
    <tbody class="table-group-divider">
        @foreach (var booking in Model)
        {
            <tr>
             
                <td>@booking.MeetingTitle</td>
                <td>@booking.BookingStatus</td>
                <td><a href="#">
                    Cancel
                    </a>
                </td>
                <!-- Display other booking details -->
            </tr>
        }
    </tbody>
</table>