﻿@using System.Security.Claims
@using MeetingRoomBooking.Services.Manager
@model MeetingRoomBooking.Services.ServiceModels.UserModel;

@section style {
        <link rel="stylesheet" href="~/css/userList.css" />
    <link rel="stylesheet" href="~/css/SearchBars.css" />
}

@{
    Layout = "_HomeLayout";
}

<div style="display:flex;">
    <h2>User List</h2>
    <div style="flex: 1;"></div>

</div>
<div class="under-title">
    <form class="dashboard-search-group" asp-action="SearchUser" method="post">
        <input type="text" placeholder="Search" class="dashboard-search" name="filter" />
        <button class="dashboard-search-btn" type="submit"><i class="bi bi-search"></i></button>
    </form>
    <a class="create-user-button" style="align-content:center" type="button" data-bs-toggle="modal" data-bs-target="#createUserModal" >
        <i class="bi bi-plus"></i>
        Add User
    </a>
</div>

<div class="flex table-container">
    <table class="table">
        <thead>
            <tr>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Email</th>
                <th>Phone No.</th>
                @* @if (int.TryParse(User.FindFirstValue("Role"), out int role) && role == 2) {
                        <th>Password</th>
                } *@
                <th>Roles</th>
                <th>Actions</th>
                
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users) {
                    <tr>
                        <td>@user.FirstName</td>
                        <td>@user.LastName</td>
                        <td>@user.Email</td>
                        <td>@user.Phone</td>
                    @* @if (int.TryParse(User.FindFirstValue("Role"), out int role2) && role2 == 2) {
                                <td>@PasswordManager.DecryptPassword(user.Password)</td>
                    } *@
                    <td>@user.Remarks</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@user.UserId" style="text-decoration:none">
                                Details<i class="bi bi-person-fill-gear" style="color:#37A3E0; font-size:20px"></i>
                            </a>
                        </td>
                        
                    </tr>
            }
        </tbody>
    </table>
</div>


<ul class="pagination">
    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
        <a class="page-link" asp-action="Index" asp-route-pageNumber="@(ViewBag.CurrentPage - 1)">Prev</a>
    </li>

    @for (int i = 1; i <= ViewBag.TotalPages; i++) {
            <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@i">@i</a>
            </li>
    }

    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
        <a class="page-link" asp-action="Index" asp-route-pageNumber="@(ViewBag.CurrentPage + 1)">Next</a>
    </li>
</ul>

<!-- Modal for Create User -->
<div class="modal fade" id="createUserModal" tabindex="-1" aria-labelledby="createUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content custom-modal-content">
            <div class="modal-header custom-modal-header">
                <h5 class="modal-title custom-modal-title" id="createUserModalLabel">Create User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form asp-controller="UserManagement" asp-action="CreateUser" method="post">
                    @Html.AntiForgeryToken()
                    <div class="user-input">
                        <div class="input-section">
                            <label for="firstName">First Name</label>
                            <input id="firstName" type="text" asp-for="CreateUser.FirstName" class="form-control" />
                        </div>
                    </div>
                    <div class="user-input">
                        <div class="input-section">
                            <label for="lastName">Last Name</label>
                            <input id="lastName" type="text" asp-for="CreateUser.LastName" class="form-control" />
                        </div>
                    </div>
                    <div class="user-input">
                        <div class="input-section">
                            <label for="email">Email</label>
                            <input id="email" type="email" asp-for="CreateUser.Email" class="form-control" />
                        </div>
                    </div>
                    <div class="user-input">
                        <div class="input-section">
                            <label for="phone">Phone</label>
                            <input id="phone" type="text" asp-for="CreateUser.Phone" class="form-control" />
                        </div>
                    </div>
                    <div class="user-input">
                        <div class="input-section">
                            <label for="password">Password</label>
                            <input id="password" type="password" asp-for="CreateUser.Password" class="form-control" />
                        </div>
                    </div>
                    <div class="user-input">
                        <div class="input-section">
                            <label for="role">Role</label>
                            <select id="role" asp-for="CreateUser.Remarks" class="form-select">
                                <option disabled selected>Select a role</option>
                                <option value="User">User</option>
                                <option value="Admin">Admin</option>
                                <option value="Super admin">Super admin</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer custom-modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary custom-submit-btn">
                            <i class="bi bi-person-plus"></i> Create User
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>





<style>
    .pagination {
        justify-content: center;
    }
    .flex {
        flex: 1;    
    }
</style>
