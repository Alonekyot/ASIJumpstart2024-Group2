@model IEnumerable<MeetingRoomBooking.Data.Models.Room>
@using MeetingRoomBooking.Resources.Constants
@{
	Layout = "_HomeLayout";
}

@section style {
	<link rel="stylesheet" href="/css/roomManagementStyle.css" />
}

<div class="rooms">
	<div>
		<h5>Meeting Rooms</h5>
		<a asp-action="Create">Create</a>
		</div>
	<div class="main">
		<main class="card-grid">

			@foreach (var room in Model)
			{
				<div class="room-card">
					<div class="image-container">
						<img src="~/assets/login-gb.jpg" alt="Alternate Text" />
					</div>	
					<div class="room-info">
						<div class="info-top">
							<h6>@room.RoomName</h6>
							<p><span>Seating capacity: </span>@room.RoomCapacity</p>
						</div>
						<p><span>Location: </span>@room.RoomLocation</p>
					</div>
					<div class="amenities">
						<p> <span>Amenities: </span></p>
						Icons
					</div>
					<div>
						<form asp-action ="Delete" method="post">
						<button type="submit" class="btn btn-primary" asp-route-id="@room.RoomId">
							Delete
						</button>
						</form>
					</div>
					<div class="edit-details"><a href="#">Edit details</a></div>
				</div>
			}

		</main>
		
	</div>
</div>



