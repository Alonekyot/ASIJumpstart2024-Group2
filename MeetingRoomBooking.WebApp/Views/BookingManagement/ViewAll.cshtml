@model IEnumerable<MeetingRoomBooking.Data.Models.Booking>
@{
    Layout = "_HomeLayout";
}
@section style{
    <link rel="stylesheet" href="~/css/ViewBookings.css" />
}

<a asp-action="Index" class="btn btn-primary btnBack">Back</a>

<div class="accordion-area" id="bookingsAccordion">
    @foreach (var booking in Model) {
        <details class="accordion">
            <summary class="accordion-head">
                <span>@booking.MeetingTitle</span>
                <form asp-action="CancelRecurring" method="post" class="d-inline cancel-form">
                    <input type="hidden" name="id" value="@booking.BookingId" />
                    <button type="submit" class="btnCancel">Cancel All</button>
                </form>
            </summary>
            <ul class="meeting-list">
                @foreach(var instance in booking.BookingInstances) {
                    <hr style="margin: 0;" />
                    <li class="meeting">
                        <span>@instance.MeetingDate.ToString("ddd, dd MMM yyyy") (@instance.StartTime - @instance.EndTime)</span>
                        
                        <form class="" method="post" asp-action="CancelBook">
                            <a class="btnCancel" asp-action="Edit" asp-route-id="@instance.BookingInstanceId">Edit</a>
                            <input type="hidden" name="meetingId" value="@instance.BookingInstanceId" />
                            <button type="submit" class="btnCancel">Cancel</button>
                        </form>
                        
                    </li>
                }
            </ul>
        </details>

    }
</div>
