@using MeetingRoomBooking.Resources.Constants
@model MeetingRoomBooking.Services.ServiceModels.CreateBooking
@{
    Layout = "_HomeLayout";
}
@section style {
    <link rel="stylesheet" href="~/css/CreateBooking.css" />
}
@section script {
    <script src="~/js/CreateBooking.js"></script>
}

<link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.0/main.min.css" rel="stylesheet" />


<div class="form-container">
    <div id="calendar"></div>
    <form asp-action="CreateBooking">
        @Html.AntiForgeryToken()
        <input type="hidden" id="roomId" name="roomId" value="@ViewBag.roomId" />
        <div class="input-grp ">
            <span class="input-label" id="inputGroup-sizing-sm">Meeting Title</span>
            <input type="text"
                   asp-for="MeetingTitle"
                   class="form-control"
                   aria-label="Sizing example input"
                   aria-describedby="inputGroup-sizing-sm">
        </div>
        <span asp-validation-for="MeetingTitle" class="error-message" style="color: red; margin-bottom: 15px;"></span>
        <div class="input-grp ">
            <span class="input-label" id="inputGroup-sizing-sm">Meeting date</span>
            <input type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")"
                   asp-for="MeetingDate"
                   class="form-control"
                   aria-label="Sizing example input"
                   aria-describedby="inputGroup-sizing-sm">
        </div>
        <div class="input-grp ">
            <span class="input-label" id="inputGroup-sizing-sm">Starts at</span>
            <input type="time" value="@DateTime.Now.AddHours(1).ToString("HH:00")"
                asp-for="TimeStart"
                   class="form-control"
                   aria-label="Sizing example input"
                   aria-describedby="inputGroup-sizing-sm">
        </div>
        <div class="input-grp ">
            <span class="input-label" id="inputGroup-sizing-sm">Ends at</span>
            <input type="time" value="@DateTime.Now.AddHours(2).ToString("HH:00")"
                asp-for="TimeEnd"
                   class="form-control"
                   aria-label="Sizing example input"
                   aria-describedby="inputGroup-sizing-sm">
        </div>
        <span asp-validation-for="TimeEnd" class="error-message" style="color: red; margin-bottom: 15px;"></span>
        <div class="check-switch">
            <label class="switch">
                <input type="checkbox" value="true" id="flexCheckDefault" asp-for="IsRecurring" />
                <span class="slider"></span>
            </label>
            <span>Recurring</span>
        </div>
        <div id="recurring-form">
            <select class="form-select input-grp" aria-label="Default select example" asp-for="RecurringPattern">
                @foreach (var pattern in Enum.GetValues(typeof(Enums.RecurringPatterns))) {
                    <option value="@pattern.ToString()">@pattern</option>
                }
            </select>
            <div class="input-grp ">
                <span class="input-label" id="inputGroup-sizing-sm">End</span>
                <input type="date"
                    asp-for="RecurringEnd"
                       class="form-control"
                       aria-label="Sizing example input"
                       aria-describedby="inputGroup-sizing-sm ">
            </div>
        </div>
        <span asp-validation-for="MeetingDate" class="error-message" style="color: red; margin-bottom: 15px;"></span>
        <button class="primary-btn" type="submit">
            Book
        </button>
    </form>
</div>




<script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.0/main.min.js"></script>

