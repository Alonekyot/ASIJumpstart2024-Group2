@model IEnumerable<MeetingRoomBooking.Data.Models.Room>
@{
	Layout = "_HomeLayout";
}
@section style {
	<link href="~/css/bookingManagementStyle.css" rel="stylesheet" />
	<link href="~/css/Cards.css" rel="stylesheet" />
	<link href="~/css/notificationBox.css" rel="stylesheet" />
	<link rel="stylesheet" href="~/css/Tooltip.css" />
}
<div class="flex" >
	<form class="filter" asp-action="FilterRoom" method="post">
		<p class="filter-title">Filter</p>
		<div class="filter-section">
			<div class="flex-center1">
				<input type="text" class="search" name="SearchText" placeholder="Search Room" />
				<button class="filter-button" type="submit"><i class="bi bi-funnel"></i></button>
			</div>
			<div class="font-lato">
				<section>
					<p class="category">Room capacity</p>
					<ul>
						<li>
							<label>
								<input type="radio" name="RoomCapacity" value="1-10"/>
								1 - 10 Seating
							</label>
						</li>
						<li>
							<label>
								<input type="radio" name="RoomCapacity" value="11-20" />
								11 - 20 Seating
							</label>
						</li>
						<li>
							<label>
								<input type="radio" name="RoomCapacity" value="21-30" />
								21 - 30 Seating
							</label>
						</li>
						<li>
							<label>
								<input type="radio" name="RoomCapacity" value="31-40" />
								31 - 40 Seating
							</label>
						</li>
						<li>
							<label>
								<input type="radio" name="RoomCapacity" value="41-50" />
								41 - 50 Seating
							</label>
						</li>
						<li>
							<label>
								<input type="radio" name="RoomCapacity" value="51-1000" />
								50+ Seating
							</label>
						</li>
					</ul>
				</section>
				<section>
					<p class="category">Amenities</p>
					<ul>
						<li>
							<label>
								<input type="checkbox" name="SelectedAmenities" value="Audio" />
								Audio
							</label>
						</li>
						<li>
							<label>
								<input type="checkbox" name="SelectedAmenities" value="Video" />
								Video
							</label>
						</li>
						<li>
							<label>
								<input type="checkbox" name="SelectedAmenities" value="Projector" />
								Projector
							</label>
						</li>
						<li>
							<label>
								<input type="checkbox" name="SelectedAmenities" value="WhiteBoard" />
								White Board
							</label>
						</li>
						<li>
							<label>
								<input type="checkbox" name="SelectedAmenities" value="LoudSpeaker" />
								Loud Speaker
							</label>
						</li>
					</ul>
				</section>
			</div>
		</div>
	</form>



	<main class="flex-grow-1 horizontal-margin padding-20">
		<div class="flex justify-content-between book-title">
			<h6 class="room-title">ROOMS AVAILABLE</h6>
			<a asp-action="ViewAll">My Bookings</a>
		</div>
		<div class="card-grid">
			@foreach (var room in Model)
			{
				<div class="flex book-card">
					<div class="book-image-container">
						@if (room.Image != null && room.Image.Length > 0) {
							// Convert byte[] to base64 string and set it as the image source
							var base64Image = Convert.ToBase64String(room.Image);
							<img src="data:image/jpeg;base64,@base64Image" alt="Room Image" />
						}
						else {
							// Fallback to a default image if no image is available
							<img src="~/assets/login-gb.jpg" alt="Room Image" />
						}
					</div>
					<div class="room-info flex-grow-1">
						<h4 class="card-title">@room.RoomName</h4>
						<div class="room-details">
							<div><span>Seating capacity: </span>
								<p class="info-book-manage">@room.RoomCapacity</p>
							</div>
							<div><span>Location: </span>
								<p class="info-book-manage">@room.RoomLocation</p>
							</div>
							<div class="amenities">
								<p> <span>Amenities: </span></p>
								<div class="icons-list">
									@if (room.Audio) {
										<div class="circle">
											<span class="tooltip">Audio</span>
											<i class="bi bi-headset"></i>
										</div>
									}
									@if (room.Video) {
										<div class="circle">
											<span class="tooltip">Video</span>
											<i class="bi bi-camera-video-fill"></i>
										</div>
									}
									@if (room.WhiteBoard) {
										<div class="circle">
											<span class="tooltip">Whiteboard</span>
											<i class="bi bi-tv-fill"></i>
										</div>
									}
									@if (room.Projector) {
										<div class="circle">
											<span class="tooltip">Projector</span>
											<i class="bi bi-projector-fill"></i>
										</div>
									}
									@if (room.Loudspeaker) {
										<div class="circle">
											<span class="tooltip">Loudspeaker</span>
											<i class="bi bi-speaker-fill"></i>
										</div>
									}
								</div>
							</div>
						</div>
					</div>
					<div>
						<a class="book-btn" asp-action="Create" asp-route-roomName="@room.RoomName" asp-route-roomId="@room.RoomId">Reserve</a>
					</div>
				</div>
			}
		</div>
	</main>
</div>

@if (TempData["bookedSuccess"] != null)
{
	<div id="notification" class="alert alert-success notification">
		@TempData["bookedSuccess"]
	</div>
	<audio id="notificationSound" src="/sound/notificationSound.mp3"></audio>
}

<script>
	let notificationPlayed = false; // Ensure the sound is played only once

	   window.onload = function () {
		   const notification = document.getElementById('notification');
			  const sound = document.getElementById('notificationSound');

				 if (notification && sound && !notificationPlayed) {
				  sound.play().catch(error => {
				   console.error("Notification sound failed to play:", error);
			});

			 notificationPlayed = true; // Mark as played

			 // Optionally fade out the notification after a delay
			 setTimeout(() => {
				 notification.style.opacity = '0';
				 setTimeout(() => notification.remove(), 500); // Remove from DOM after fade-out
			 }, 2000);
		 }
	 };
</script>
