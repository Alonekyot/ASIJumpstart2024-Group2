@model IEnumerable<MeetingRoomBooking.Data.Models.Room>
@{
	Layout = "_HomeLayout";
}
@section style {
	<link href="~/css/bookingManagementStyle.css" rel="stylesheet" />
	<link href="~/css/Cards.css" rel="stylesheet" />
	<link href="" />
}
<div class="flex">
	<aside class="filter">
		<p class="filter-title">Filter</p>
		<div class="filter-section">
			<div class="flex-center1">
				<input type="text" class="search" placeholder="Search here" />
				<button class="filter-button"><i class="bi bi-funnel"></i></button>
			</div>
			<div class="font-lato">
				<section>
					<p class="category">Room capacity</p>
					<ul>
						<li>
							<label>
								<input type="checkbox" />
								5 seating
							</label>
						</li>
						<li>
							<label>
								<input type="checkbox" />
								10 seating
							</label>
						</li>
						<li>
							<label>
								<input type="checkbox" />
								15 seating
							</label>
						</li>
						<li>
							<label>
								<input type="checkbox" />
								25 seating
							</label>
						</li>
					</ul>
				</section>
				<section>
					<p class="category">Amenities</p>
					<ul>
						<li>
							<label>
								<input type="checkbox" />
								Audio
							</label>
						</li>
						<li>
							<label>
								<input type="checkbox" />
								Video
							</label>
						</li>
						<li>
							<label>
								<input type="checkbox" />
								Projector
							</label>
						</li>
						<li>
							<label>
								<input type="checkbox" />
								White Board
							</label>
						</li>
						<li>
							<label>
								<input type="checkbox" />
								Loud Speaker
							</label>
						</li>
					</ul>
				</section>
			</div>
		</div>
	</aside>
	<main class="flex-grow-1 horizontal-margin padding-20">
		<div class="flex justify-content-between book-title">
			<h6 class="room-title">ROOMS AVAILABLE</h6>
			<a asp-action="ViewAll">View Bookings</a>
		</div>
		<div class="card-grid">
			@foreach (var room in Model)
			{
				<div class="flex book-card">
					<div class="book-image-container">
						@if (room.Image != null && room.Image.Length > 0) {
							// Convert byte[] to base64 string and set it as the image source
							var base64Image = Convert.ToBase64String(room.Image);
							<img src="data:image/jpeg;base64,@base64Image" alt="Room Image" />
						}
						else {
							// Fallback to a default image if no image is available
							<img src="~/assets/login-gb.jpg" alt="Room Image" />
						}
					</div>
					<div class="room-info flex-grow-1">
						<h4 class="card-title">@room.RoomName</h4>
						<div class="room-details">
							<div><span>Seating capacity: </span>
								<p class="info-book-manage">@room.RoomCapacity</p>
							</div>
							<div><span>Location: </span>
								<p class="info-book-manage">@room.RoomLocation</p>
							</div>
							<div class="amenities">
								<p> <span>Amenities: </span></p>
								<div class="icons-list">
									@if (room.Audio)
									{
										<div class="circle">
											<i class="bi bi-headset"></i>
										</div>
									}
									@if (room.Video)
									{
										<div class="circle">
											<i class="bi bi-camera-video-fill"></i>
										</div>
									}
									@if (room.WhiteBoard)
									{
										<div class="circle">
											<i class="bi bi-tv-fill"></i>
										</div>
									}
									@if (room.Projector)
									{
										<div class="circle">
											<i class="bi bi-projector-fill"></i>
										</div>
									}
									@if (room.Loudspeaker)
									{
										<div class="circle">
											<i class="bi bi-speaker-fill"></i>
										</div>
									}
								</div>
							</div>
						</div>
					</div>
					<div>
						<a class="book-btn" asp-action="Create" asp-route-roomName="@room.RoomName" asp-route-roomId="@room.RoomId">Book</a>
					</div>
				</div>
			}
		</div>
	</main>
</div>
